# Copy this file to .env and paste your Hugging Face token. .env is git-ignored.
#   cp .env.example .env
#
# Create a token at https://huggingface.co/settings/tokens
#   - Easiest: a "Read" token (classic). If you make a fine-grained token, tick
#     "Make calls to Inference Providers" and "Read access to public gated repos".
#   - Inference Providers bill your Hugging Face credits / pay-as-you-go balance: check your billing page first.
#   - add "Write" access only if you want scripts/backup_to_hub.py to upload your adapters
HF_TOKEN=hf_paste_your_token_here

# Optional: private Hub repo that stores your trained adapters and results (so a new GPU box can restore them)
# HF_BACKUP_REPO=your-username/veriquery-artifacts

# Optional overrides
# VERIQUERY_HOME=/workspace/veriquery
# VERIQUERY_PROFILE=local_all
